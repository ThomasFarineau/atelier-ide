# Fins de ligne normalisées : LF dans le dépôt et sur disque.
* text=auto eol=lf

# Scripts Windows
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

*.rs   text diff=rust
*.md   text diff=markdown
*.svg  text

*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary

Cargo.lock linguist-generated=true -diff
